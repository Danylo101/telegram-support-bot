# =======================================================
# ===           Загальні повідомлення та помилки      ===
# =======================================================

error_data = ⚠️ Сталася помилка. Некоректні дані.
invalid_ticket_id = ⚠️ Вказано некоректний ID тікету.
state_error_data_lost = ⚠️ Сталася помилка стану, дані було втрачено. Спробуйте, будь ласка, ще раз.
user_not_found = ⚠️ Не вдалося знайти ваш профіль. Спробуйте /start для реєстрації.
unknown_user = ⚠️ Ви ще не зареєстровані. Будь ласка, використайте /start.
error_ticket_id = ⚠️ Помилка ID тікету.


# =======================================================
# ===           Флоу Користувача (User)             ===
# =======================================================

start =
    👋 Привіт, <b>{ $first_name }!</b>

    Я — ваш бот техпідтримки, і я тут, щоб допомогти вам швидко та зручно.

    💡 Ось що ви можете зробити:

    📩 <b>Створити заявку на допомогу</b>
    📝 <b>Перевірити статус існуючої заявки</b>

    Щоб почати, оберіть одну з опцій нижче.

prompt_share_contact = 👋 Вітаємо! Для реєстрації, будь ласка, натисніть на кнопку нижче, щоб поділитись вашим номером телефону.
contact_saved = ✅ Ваш номер { $phone_number } збережено. Тепер ви можете створювати заявки.
select_category = 🗂️ Будь ласка, виберіть категорію вашого звернення:

# --- Створення тікету ---
describe_problem = 📝 Будь ласка, опишіть вашу проблему якомога детальніше. Ви також можете прикріпити фото до повідомлення (як опис до фото).
is_correct_description = 📤 Надіслати цю заявку?
enter_description_again = 🔄 Будь ласка, введіть опис ще раз.
request_saved = ✅ Заявку надіслано. Наш оператор незабаром її опрацює.
add_description_to_photo = 📸 Будь ласка, додайте опис проблеми у підписі до вашого фото.
add_description_to_your_photo = 📸 Будь ласка, додайте опис до вашого фото.
send_description_text_or_photo = ❗️ Будь ласка, надішліть опис вашої проблеми текстом або одним фото з описом.

# --- Перегляд тікетів (User) ---
tickets_empty = 📭 У вас поки що немає створених заявок. 🟢
tickets_header = <b>🟢 { $status_text }:</b>
ticket_footer = ℹ️ Щоб переглянути деталі, надішліть мені ID заявки (напр., <b>#123</b>).

ticket_short_item =
    • <b>{ $id }</b>
       <i>Опис: { $short_desc }</i>
       <i>Статус: { $status }</i> 🟢
       <i>Створено: { $created_at }</i>

ticket_not_found = ⚠️ Заявку з ID <b>{ $ticket_id }</b> не знайдено.
ticket_not_found_or_no_access = 🚫 Тікет не знайдено, або у вас немає до нього доступу.

ticket =
    🎫 <b>Заявка { $ticket_id }</b>

    🔎 <b>Опис:</b>
    { $description}

    <b>Відповіді:</b>
    { $comments }

    <i>📌 Статус: { $status }</i>
    <i>🕒 Створено: { $created_at}</i>

# --- Додавання повідомлення до тікету (User) ---
prompt_add_clarification = ✍️ Будь ласка, напишіть ваше уточнення. Ви також можете прикріпити фото.
message_added_to_ticket = ✅ Ваше повідомлення додано до тікету. Оператор незабаром вам відповість.
cannot_add_message_ticket_closed = 🔒 Неможливо додати повідомлення, оскільки цей тікет закрито.
state_error_try_again = ⚠️ Сталася помилка стану. Спробуйте натиснути кнопку "Уточнити проблему" ще раз.

# --- Закриття тікету (User) ---
ticket_already_closed = ℹ️ Цей тікет вже закрито.
ticket_closed_success = ✅ Тікет <b>#{ $ticket_seq_id }</b> успішно закрито.

# --- Сповіщення (User) ---
user_new_reply_notification =
    🔔 <b>Нова відповідь у тікеті #{ $ticket_seq_id }</b>

    <b>Підтримка:</b> { $text }


# =======================================================
# ===           Флоу Оператора (Operator)           ===
# =======================================================

status =
    📊 <b>Статистика заявок:</b>

    <b>🟢 Відкритих: { $open_count }</b>
    <b>🟡 В процесі: { $in_progress_count }</b>

status_text_open = Відкриті заявки
status_text_in_progress = Заявки в роботі
operator_tickets_empty = <b>{ $status_text }</b>: Заявки відсутні 🟢
operator_ticket_list_header = <b>{ $status_text }</b> (Сторінка { $page } / { $total_pages })

    Оберіть тікет для відповіді:

# --- Відповідь оператора ---
send_respond = ✍️ Надішліть вашу відповідь для клієнта:
correct_respond = ✅ Надіслати цю відповідь користувачу?
enter_respond_again = 🔄 Будь ласка, надішліть відповідь ще раз.
respond_sanded = ✅ Відповідь надіслано.
operator_reply_saved_not_sent = ⚠️ <i>(Відповідь збережено, але не вдалося сповістити клієнта. Можливо, він заблокував бота)</i>

# --- Нотатки оператора ---
operator_prompt_internal_note = ✍️ Надішліть текст внутрішньої нотатки (клієнт її не побачить):
operator_confirm_note =
    📝 <b>Додати цю нотатку?</b>
    <i>{ $text }</i>
operator_note_added = ✅ Нотатку додано.
operator_note_cancelled = ❌ Додавання нотатки скасовано.

# --- Перегляд тікету (Operator) ---
unknown_user_fallback = Невідомий
not_specified = Не вказано
no_category = Без категорії
unknown_category = Невідома
not_set = Не встановлено
tags_none = Немає
no_messages = <i>Немає повідомлень</i>
attachment_count = <i>(📎 { $count } вкл.)</i>
support_author = Підтримка
client_author = Клієнт
no_notes = <i>Немає нотаток</i>
system_author = Система

operator_ticket_view =
    🎫 <b>Тікет #{ $ticket_seq_id }</b>
    
    <b>Клієнт:</b> { $client_str }
    <b>Телефон:</b> { $client_phone }
    <b>Категорія:</b> { $category_str }
    
    <b>Статус:</b> { $status }
    <b>Пріоритет:</b> { $priority }
    <b>Теги:</b> { $tags }
    
    <b>Створено:</b> { $created_str }
    <b>Оновлено:</b> { $updated_str }
    <b>SLA Due:</b> { $sla_str }
    
    <b>Історія листування:</b>
    { $history }
    
    <b>Внутрішні нотатки:</b>
    { $notes }

# --- Вкладення (Operator) ---
no_attachments_in_ticket = ℹ️ У цьому тікеті немає вкладень.
attachments_for_ticket = 📎 <b>Вкладення для тікета #{ $ticket_seq_id }:</b>
error_loading_attachment = ⚠️ <i>Не вдалося завантажити вкладення (ID: { $file_unique_id })</i>


# =======================================================
# ===           Флоу Адміна (Admin)                 ===
# =======================================================

admin_db_cleared = ✅ Базу даних (тікети та користувачі) очищено.
admin_prompt_category_description = ✍️ Введіть опис для нової категорії.
admin_prompt_category_name = 🏷️ Введіть назву нової категорії у форматі: /add_category <назва>
admin_error_name_not_found = ⚠️ Сталася помилка (ім'я категорії не знайдено). Спробуйте знову.
admin_category_created = ✅ Категорію <b>{ $name }</b> створено.
# --- Додавання статті (Admin) ---
admin_prompt_article_title = ✍️ Введіть назву для нової статті (FAQ):
admin_prompt_article_content = 📝 Введіть повний текст (вміст) статті:
admin_article_created = ✅ Статтю "<b>{ $title }</b>" успішно створено та опубліковано.
admin_no_categories_found = ⚠️ Не знайдено жодної категорії. Спочатку створіть категорію через /add_category, щоб прив'язати до неї статтю.

# =======================================================
# ===           База знань                            ===
# =======================================================
articles_empty = Не знайдено жодної статті
article_not_found = Щось пішло не так коли шукали статтю
select_article = some text